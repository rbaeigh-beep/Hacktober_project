import json
# Import your exact, untouched function from ai_helper.py
from ai_helper import ask_gemma

def rasha_parser_pipeline(user_note):
    """
    SECTION 1: THE AI DATA PARSER
    Uses the existing ask_gemma function to extract travel details
    and converts the raw text response into a clean Python dictionary.
    """
    # 1. Design a strict prompt layout that forces a raw data response
    structured_instructions = f"""
    You are a strict data-extraction engine for a travel spreadsheet app.
    Analyze this raw user note: "{user_note}"
    
    Find a real or highly realistic local venue that fits their request perfectly.
    You must respond ONLY with a single, raw JSON object. Do not include markdown wraps, code block formatting, or backticks like ```json.
    
    Use this exact JSON format layout:
    {{
        "venue_name": "Name of the business",
        "price_tier": "Use exactly £, ££, or £££",
        "estimated_cost": 15,
        "opening_hours": "e.g., 08:00 AM - 06:00 PM",
        "street_address": "Full street address of the location",
        "latitude": 51.5074,
        "longitude": -0.1278
    }}
    """
    
    # 2. Call your untouched, generic AI integration function
    raw_ai_text = ask_gemma(structured_instructions)
    
    # 3. Text-to-Data Parsing and Safety Shielding
    try:
        # Clean up text formatting just in case the AI added accidental markdown blocks
        clean_text = raw_ai_text.strip().replace("```json", "").replace("```", "").strip()
        
        # Convert the raw text string into a native, workable Python dictionary
        data_packet = json.loads(clean_text)
        return data_packet
        
    except Exception as error:
        # Fallback shield: If the AI output is weird or unparseable, return 
        # a safe dummy dictionary so Vidula's UI doesn't crash.
        return {
            "venue_name": "Emergency Fallback Spot",
            "price_tier": "£",
            "estimated_cost": 0,
            "opening_hours": "N/A",
            "street_address": f"Parsing Error. Raw Text was: {raw_ai_text[:50]}...",
            "latitude": 51.5074,
            "longitude": -0.1278
        }
